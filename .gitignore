数据集/
data/*.npz
models/*.pt
experiments/*.npz

# 运行日志与本机痕迹（含绝对路径，不入库）
experiments/_*.log
tools/_*.log
docs/_*.txt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# 环境与缓存
.venv/
.env
.pytest_cache/
experiments/*.pt
results/*.png
results/*.pdf

